# ---------------------------------------------------------------------------
# Copy this file to `.env` (in the repo root) and fill in your own values.
# The server reads these via dotenv. Never commit your real .env file.
# ---------------------------------------------------------------------------

# TMDB API (https://www.themoviedb.org/settings/api)
# Either a v3 API key OR a v4 read access token works. v4 token takes priority.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Region used for streaming availability lookups (ISO 3166-1 alpha-2).
WATCH_REGION=FR

# Language for TMDB metadata responses.
TMDB_LANGUAGE=fr-FR

# Optional: YouTube Data API v3 key, enables "free full film on YouTube" lookups.
# Leave empty to disable the (noisy / best-effort) YouTube source.
YOUTUBE_API_KEY=

# Toggle individual free sources (true/false).
ENABLE_INTERNET_ARCHIVE=true
ENABLE_YOUTUBE=false

# Server port.
PORT=5174

# Cache time-to-live in hours.
CACHE_TTL_AVAILABILITY_HOURS=24
CACHE_TTL_FILM_META_HOURS=168

# Politeness / rate limiting for the Letterboxd scraper.
SCRAPE_CONCURRENCY=4
SCRAPE_DELAY_MS=350
